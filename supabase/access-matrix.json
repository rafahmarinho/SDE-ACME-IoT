{
  "description": "Query-level access chart (SD Elements T2598): every account, role and process that reaches the ACME IoT database, the objects each one needs and the commands allowed on them. Role lists cover rows of the caller's own organization; 'self' lists the commands every role has on its own row. Columns restrict the commands listed. scripts/verify-security-controls.ts compares this chart with the effective policies and grants of supabase/migrations.",
  "accounts": [
    {
      "account": "anon",
      "kind": "database role",
      "usedBy": "requests that carry only the public anon key (no signed-in user)",
      "access": "no table, sequence or function privileges"
    },
    {
      "account": "authenticated",
      "kind": "database role",
      "usedBy": "signed-in members: the /api functions forward the caller's own JWT; the Expo client only reads its own profile at sign-in",
      "access": "per table below, filtered by row-level security on the caller's organization and application role (owner, administrator, operator, viewer)"
    },
    {
      "account": "vercel_api",
      "kind": "application process",
      "usedBy": "/api/data, /api/commands, /api/devices",
      "access": "connects as authenticated with the caller's token (never the service role)"
    },
    {
      "account": "service_role",
      "kind": "platform process",
      "usedBy": "device telemetry ingestion, alert generation and the audit retention purge; never used by the app or /api",
      "access": "bypasses RLS; events_log stays append-only; executes purge_events_log"
    },
    {
      "account": "supabase_auth_admin",
      "kind": "platform process",
      "usedBy": "Supabase Auth custom access token hook",
      "access": "SELECT user_profiles; EXECUTE custom_access_token_hook"
    }
  ],
  "roles": [
    "owner",
    "administrator",
    "operator",
    "viewer"
  ],
  "tables": {
