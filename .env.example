# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# API base URL: leave empty for the web build (same-origin /api). Native builds set the https deployment URL;
# http is only accepted for localhost during development (e.g. http://localhost:3000 with `vercel dev`).
EXPO_PUBLIC_API_URL=

# Platform Environment
NODE_ENV=development
EXPO_PUBLIC_APP_ENV=development

# Server-side only (Vercel project settings; never prefix with EXPO_PUBLIC_)
# Keys /api uses to verify Supabase access tokens (set at least one; the API fails closed without them)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_JWKS=
# Public anon key /api uses to ask Supabase Auth whether a session is still active (defaults to EXPO_PUBLIC_SUPABASE_ANON_KEY)
SUPABASE_ANON_KEY=
# Exact origins allowed to call /api cross-origin, comma-separated (empty = same-origin only)
ALLOWED_ORIGINS=

# Supabase CLI only: deployed web URL used by supabase/config.toml when running `supabase config push`
SUPABASE_AUTH_SITE_URL=

# Demo personas, persona/tenant switcher and Reset Demo (non-production builds only)
EXPO_PUBLIC_DEMO_MODE=false

# SD Elements sync tooling (scripts/sync-sde-tasks.ts); export in your shell or CI secrets, never commit
SDE_URL=
SDE_API_TOKEN=
